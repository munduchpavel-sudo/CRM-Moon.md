# Copy this file to .env for local/dev deployment
# cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=change_me_postgres

# Backend auth
JWT_SECRET=change_me_jwt_secret

# External APIs
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FastAPI EMS options
MODBUS_LIVE_ENABLED=false
EMS_LOG_LEVEL=INFO

# Nginx config selector (default.dev.conf or default.prod.conf)
NGINX_CONF=default.dev.conf
